# ==============================================================
# MAUSAM - SIH26076 Environment Configuration
# Ministry of Earth Sciences (MoES) / India Meteorological Department (IMD)
# ==============================================================

# Application Environment
ENV=production
DEBUG=False
PORT=8000

# Database Configuration
# For PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For zero-config SQLite: sqlite:///./mausam.db (Automatic fallback if Postgres is unconfigured)
DATABASE_URL=sqlite:///./mausam.db

# Weather Provider Selection:
# "live" -> Real-time Open-Meteo worldwide weather, hourly, 7-day, AQI & marine data (zero API keys needed)
# "mock" -> High-fidelity Indian regional simulation (Bhuj, Mumbai, Delhi, etc.) with toggleable severe thunderstorm bulletins
# "imd"  -> Official IMD API endpoints (requires departmental credentials)
WEATHER_PROVIDER=live

# Official IMD API Credentials (Optional - only required if WEATHER_PROVIDER=imd)
IMD_API_BASE_URL=https://api.imd.gov.in/v1
IMD_API_KEY=

# Multi-Tier In-Memory Cache TTL Settings (in seconds)
CACHE_TTL_CURRENT_SECONDS=600
CACHE_TTL_FORECAST_SECONDS=1800
CACHE_TTL_WARNINGS_SECONDS=300

# Frontend API URL (Used when building or running frontend)
VITE_API_BASE_URL=http://localhost:8000/api
